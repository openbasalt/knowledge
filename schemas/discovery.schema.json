{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbasalt.org/schemas/knowledge/v0/discovery.schema.json",
  "title": "Discovery payload (payloadType application/vnd.openbasalt.knowledge.discovery+json), signed by the delegated online key",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "versions", "issued_at", "namespaces", "limits", "privacy"],
  "properties": {
    "schema": { "const": "kb.discovery/v0" },
    "versions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]+$" } },
    "issued_at": { "$ref": "common.schema.json#/$defs/time" },
    "namespaces": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "languages", "bundle", "keyring_version", "delegation"],
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/namespace" },
          "languages": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/lang" } },
          "bundle": { "$ref": "common.schema.json#/$defs/bundleRef" },
          "keyring_version": { "type": "integer", "minimum": 1 },
          "delegation": { "$ref": "envelope.schema.json" }
        }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false, "required": ["max_request_bytes", "max_results", "rate_limit"],
      "properties": {
        "max_request_bytes": { "type": "integer", "minimum": 1024 },
        "max_results": { "type": "integer", "minimum": 1 },
        "rate_limit": {
          "type": "object", "additionalProperties": false, "required": ["requests", "seconds", "burst"],
          "properties": {
            "requests": { "type": "integer", "minimum": 1 },
            "seconds": { "type": "integer", "minimum": 1 },
            "burst": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "privacy": { "type": "array", "items": { "type": "string" } }
  }
}
