{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbasalt.org/schemas/knowledge/v0/discovery.schema.json",
  "title": "Discovery payload (payloadType application/vnd.openbasalt.knowledge.discovery+json), signed by the delegated online key",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "versions", "issued_at", "namespaces", "limits", "privacy"],
  "properties": {
    "schema": { "const": "kb.discovery/v0" },
    "versions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]+$" } },
    "issued_at": { "$ref": "common.schema.json#/$defs/time" },
    "namespaces": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "languages", "bundle", "keyring_version", "delegation"],
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/namespace" },
          "languages": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/lang" } },
          "bundle": { "$ref": "common.schema.json#/$defs/bundleRef" },
          "keyring_version": { "type": "integer", "minimum": 1 },
          "delegation": { "$ref": "envelope.schema.json" }
        }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false, "required": ["max_request_bytes", "max_results", "rate_limit"],
      "properties": {
        "max_request_bytes": { "type": "integer", "minimum": 1024 },
        "max_results": { "type": "integer", "minimum": 1 },
        "rate_limit": {
          "type": "object", "additionalProperties": false, "required": ["requests", "seconds", "burst"],
          "properties": {
            "requests": { "type": "integer", "minimum": 1 },
            "seconds": { "type": "integer", "minimum": 1 },
            "burst": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "privacy": {
      "description": "service: promises about the server process itself. hosting: the operator's statement about the hosting layer in front of it (proxies, ingress), which the service cannot control.",
      "type": "object", "additionalProperties": false, "required": ["service", "hosting"],
      "properties": {
        "service": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 64 }
        },
        "hosting": { "$ref": "#/$defs/hosting" }
      }
    }
  },
  "$defs": {
    "hosting": {
      "oneOf": [
        {
          "description": "Not declared: clients assume the host may keep client addresses for an unknown time.",
          "type": "object", "additionalProperties": false, "required": ["declared"],
          "properties": { "declared": { "const": false } }
        },
        {
          "description": "Declared, with access logs.",
          "type": "object", "additionalProperties": false,
          "required": ["declared", "access_logs", "retention_days", "fields", "query_body_logged"],
          "properties": {
            "declared": { "const": true },
            "provider": { "$ref": "#/$defs/provider" },
            "access_logs": { "const": true },
            "retention_days": { "type": "integer", "minimum": 0, "maximum": 3650 },
            "fields": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "enum": ["ip", "time", "method", "path", "status", "size", "duration", "host", "user_agent", "referer"] }
            },
            "query_body_logged": { "type": "boolean" }
          }
        },
        {
          "description": "Declared, without access logs.",
          "type": "object", "additionalProperties": false,
          "required": ["declared", "access_logs", "query_body_logged"],
          "properties": {
            "declared": { "const": true },
            "provider": { "$ref": "#/$defs/provider" },
            "access_logs": { "const": false },
            "query_body_logged": { "const": false }
          }
        }
      ]
    },
    "provider": { "type": "string", "minLength": 1, "maxLength": 64 }
  }
}
